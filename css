@import url('https://fonts.googleapis.com/css2?family=Jersey+15&display=swap');

@import url('https://fonts.cdnfonts.com/css/doxent');

body{
    display: flex;
    background: linear-gradient(
       #424141,#262627,#0c0b14
    );
    font-family: "Jersey 15", sans-serif;               
    margin-left: 100px;   
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}


.top-bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 5px;
    width: 150px;
    height: 100vh;
    box-sizing: border-box;
    position: fixed;
    top: 0;
    left: 0;
    background: linear-gradient(#0f0f0f,#313131);
    border: solid 1px #555;
    z-index: 1000;
}
.navbar ul {
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    position: relative;
}

.navbar a {
    color: white;
    text-decoration: none;
    font-size: 20px;
    font-family: "DOXENT", sans-serif;
}

.navbar ul a:hover{
    background-color: hsl(180, 1%, 15%);
    transition: all 0.3s ease;
}


hr{
    border:#413d3d;
    background-color:#413d3d;
    width:120px;
    height:0.5px;
}

.actions {
    display: flex;
    align-items: center;
}


